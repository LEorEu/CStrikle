# LLM 对手配置(OpenAI 兼容接口,不配则对战模式只能人人对战)
AI_BASE_URL=https://your-proxy.example.com/v1
AI_API_KEY=sk-xxx
AI_MODEL=gpt-4o-mini
# 是否允许 AI 调用网络搜索(DuckDuckGo)
AI_SEARCH_ENABLED=1
# 每轮 agent 循环最大步数
AI_MAX_STEPS=2
# 单次模型请求上限；SDK 重试已在应用中关闭
AI_TIMEOUT_SECONDS=35
# 候选数不超过该值时启用有限步精确求解
AI_EXACT_THRESHOLD=10
# DDGS 查询缓存秒数
AI_SEARCH_CACHE_TTL_SECONDS=3600
# native | text | auto
AI_TOOLS_MODE=auto
# 支持该参数的推理模型可设为 low，减少每回合延迟
AI_REASONING_EFFORT=low
# 可选 enabled | disabled；留空时使用上游模型默认。DeepSeek V4 建议显式设置。
AI_THINKING_MODE=
# 同一客户端 IP 创建 AI 房间的滑动窗口限频
AI_ROOM_RATE_LIMIT=3
AI_ROOM_RATE_WINDOW_SECONDS=600
